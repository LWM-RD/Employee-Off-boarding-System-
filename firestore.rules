rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Offboardings Collection (records and snapshot checklists)
    match /offboardings/{offboardingId} {
      allow read, write: if request.auth != null || request.time < timestamp.date(2030, 1, 1);
    }

    // Templates Collection (master Entra ID & Intune checklist template)
    match /templates/{templateId} {
      allow read, write: if request.auth != null || request.time < timestamp.date(2030, 1, 1);
    }

    // Admins Collection
    match /admins/{adminUid} {
      allow read, write: if request.auth != null || request.time < timestamp.date(2030, 1, 1);
    }
  }
}
